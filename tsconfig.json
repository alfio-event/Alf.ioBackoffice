{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2020",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmitHelpers": true,
        "noEmitOnError": true,
        "lib": [
            "es2017",
            "dom",
            "ESNext"
        ],
        "paths": {
            "~/*": [
                "./src/*"
            ],
            "@/*": [
                "./src/*"
            ]
        },
        "moduleResolution": "bundler",
        "removeComments": false,
        "skipLibCheck": true,
        "strict": false
    },
    "include": [
        "src/**/*.ios.ts",
        "src/**/*.android.ts"
    ],
    "files": [
        "./src/main.ts",
        "./references.d.ts",
        "./src/polyfills.ts"
    ],
    "exclude": [
        "node_modules",
        "platforms"
    ],
    "angularCompilerOptions": { "strictTemplates": false }
}